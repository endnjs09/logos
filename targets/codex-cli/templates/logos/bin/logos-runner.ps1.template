# logos-managed: true
# Logos project-local Runner shim for PowerShell.
#
# This file is generated by `logos install --target codex-cli`.
# It lets Codex call Logos Runner without relying on a global PATH entry.

$ErrorActionPreference = "Stop"

$logosSourceRoot = "{{logos_source_root}}"
$logosPython = "{{logos_python_executable}}"
$logosCodex = "{{codex_executable}}"
$logosPythonPath = @(
    (Join-Path $logosSourceRoot "packages/logos-core/src"),
    (Join-Path $logosSourceRoot "packages/logos-installer/src"),
    (Join-Path $logosSourceRoot "packages/logos-runner/src")
) -join [System.IO.Path]::PathSeparator

if (-not (Test-Path -LiteralPath $logosPython)) {
    Write-Error "Logos Python executable not found: $logosPython"
    exit 1
}

if (-not (Test-Path -LiteralPath $logosSourceRoot)) {
    Write-Error "Logos source root not found: $logosSourceRoot"
    exit 1
}

if ($env:PYTHONPATH) {
    $env:PYTHONPATH = "$logosPythonPath$([System.IO.Path]::PathSeparator)$env:PYTHONPATH"
} else {
    $env:PYTHONPATH = $logosPythonPath
}

if ($logosCodex) {
    $env:LOGOS_CODEX_EXECUTABLE = $logosCodex
} elseif (-not $env:LOGOS_CODEX_EXECUTABLE) {
    $env:LOGOS_CODEX_EXECUTABLE = "codex"
}

& $logosPython -m logos_runner.cli @args
exit $LASTEXITCODE
