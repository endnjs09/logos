#!/usr/bin/env python3
# logos-managed: true
# logos-target: codex-cli
# logos-version: {{logos_version}}
"""Logos Codex PostToolUse hook skeleton."""

from __future__ import annotations

import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def sanitize_for_json(value: object) -> object:
    if isinstance(value, str):
        return value.encode("utf-8", "replace").decode("utf-8")
    if isinstance(value, dict):
        return {str(sanitize_for_json(key)): sanitize_for_json(item) for key, item in value.items()}
    if isinstance(value, list):
        return [sanitize_for_json(item) for item in value]
    if isinstance(value, tuple):
        return [sanitize_for_json(item) for item in value]
    return value


def safe_json_dumps(value: object, **kwargs: object) -> str:
    return json.dumps(sanitize_for_json(value), **kwargs)


def main() -> int:
    raw = sys.stdin.read()
    if not raw.strip():
        return 0
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(safe_json_dumps({"systemMessage": f"Logos PostToolUse input could not be parsed: {exc}"}))
        return 0
    if isinstance(payload, dict):
        record_evidence(payload)
    return 0


def record_evidence(payload: dict[str, object]) -> None:
    cwd = extract_cwd(payload)
    if not cwd:
        return
    root = Path(cwd)
    if not root.exists():
        return
    event = {
        "schema_version": 1,
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "hook_event_name": payload.get("hook_event_name", "PostToolUse"),
        "tool_name": payload.get("tool_name", "unknown"),
        "tool_use_id": payload.get("tool_use_id", "unknown"),
        "summary": summarize_payload(payload),
    }
    path = root / ".logos" / "evidence" / "hook-events.jsonl"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as stream:
            stream.write(safe_json_dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        return
    record_run_observations(root, payload)


def extract_cwd(payload: dict[str, object]) -> str:
    for key in ("cwd", "working_directory", "workdir"):
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return ""


def summarize_payload(payload: dict[str, object]) -> str:
    tool_name = payload.get("tool_name", "unknown")
    tool_input = payload.get("tool_input")
    if isinstance(tool_input, dict):
        for key in ("command", "cmd", "script", "path", "file_path"):
            value = tool_input.get(key)
            if isinstance(value, str) and value.strip():
                return f"{tool_name}: {value[:240]}"
    return str(tool_name)


def record_run_observations(root: Path, payload: dict[str, object]) -> None:
    run = ensure_current_run(root)
    command = extract_command(payload)
    if command:
        exit_code = extract_exit_code(payload)
        summary = summarize_payload(payload)
        append_jsonl(
            root / ".logos" / "runs" / str(run["run_id"]) / "commands.jsonl",
            {
                "schema_version": 1,
                "run_id": run["run_id"],
                "recorded_at": datetime.now(timezone.utc).isoformat(),
                "command": command,
                "cwd": extract_cwd(payload),
                "tool_name": payload.get("tool_name", "unknown"),
                "exit_code": exit_code,
                "summary": summary,
            },
        )
        append_jsonl(
            root / ".logos" / "evidence" / "command-results.jsonl",
            {
                "schema_version": 1,
                "run_id": run["run_id"],
                "recorded_at": datetime.now(timezone.utc).isoformat(),
                "command": command,
                "summary": summary,
            },
        )
        run["command_count"] = int(run.get("command_count", 0)) + 1
        run["last_command"] = command
        if exit_code not in (None, 0):
            run["last_error"] = summary

    for changed in dedupe_changed_files([*detect_payload_changed_files(root, payload), *detect_changed_files(root)]):
        normalized = normalize_project_path(root, changed["path"])
        if not normalized:
            continue
        changed["path"] = normalized
        files_path = root / ".logos" / "runs" / str(run["run_id"]) / "files.jsonl"
        if file_record_exists(files_path, changed["path"]):
            continue
        append_jsonl(
            files_path,
            {
                "schema_version": 1,
                "run_id": run["run_id"],
                "recorded_at": datetime.now(timezone.utc).isoformat(),
                "path": changed["path"],
                "change_type": changed["change_type"],
                "detected_by": changed.get("detected_by", "unknown"),
            },
        )
        touched = run.setdefault("touched_files", [])
        if isinstance(touched, list) and changed["path"] not in touched:
            touched.append(changed["path"])

    write_json(root / ".logos" / "runs" / str(run["run_id"]) / "run.json", run)
    update_run_index(root, run)
    update_resume_snapshot(root, run)


def extract_command(payload: dict[str, object]) -> str:
    tool_input = payload.get("tool_input")
    if isinstance(tool_input, dict):
        for key in ("command", "cmd", "script", "shell_command"):
            value = tool_input.get(key)
            if isinstance(value, str) and value.strip():
                return value.strip()
    for key in ("command", "cmd", "script", "shell_command"):
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return ""


def extract_exit_code(payload: dict[str, object]) -> int | None:
    for key in ("exit_code", "exitCode", "status"):
        value = find_key(payload, key)
        if isinstance(value, int):
            return value
    return None


def detect_payload_changed_files(root: Path, payload: dict[str, object]) -> list[dict[str, str]]:
    changed: list[dict[str, str]] = []
    text = collect_text(payload)
    for line in text.splitlines():
        stripped = line.strip()
        for prefix, change_type in (
            ("*** Add File: ", "added"),
            ("*** Update File: ", "modified"),
            ("*** Delete File: ", "deleted"),
        ):
            if stripped.startswith(prefix):
                path = normalize_project_path(root, stripped.removeprefix(prefix).strip())
                if path:
                    changed.append({"path": path, "change_type": change_type, "detected_by": "apply-patch"})

    for key in ("path", "file_path", "filepath", "filename", "target_file"):
        for value in find_all_keys(payload, key):
            if isinstance(value, str) and value.strip():
                path = normalize_project_path(root, value.strip())
                if path:
                    changed.append({"path": path, "change_type": "modified", "detected_by": f"payload:{key}"})
    return changed


def normalize_project_path(root: Path, value: str) -> str:
    candidate = value.strip().strip("'\"")
    if not candidate or candidate.startswith("<"):
        return ""
    try:
        path = Path(candidate)
        if path.is_absolute():
            resolved = path.resolve()
            try:
                normalized = str(resolved.relative_to(root.resolve())).replace("\\", "/")
                return normalized if is_project_touched_file(normalized) else ""
            except ValueError:
                return ""
        normalized = str(path).replace("\\", "/")
        return normalized if is_project_touched_file(normalized) else ""
    except OSError:
        return ""


def is_project_touched_file(value: str) -> bool:
    normalized = value.strip().replace("\\", "/")
    if not normalized:
        return False
    if normalized == ".logos" or normalized.startswith(".logos/"):
        return False
    if normalized.startswith("/"):
        return False
    if "/" not in normalized:
        return False
    return True


def dedupe_changed_files(changed: list[dict[str, str]]) -> list[dict[str, str]]:
    result: list[dict[str, str]] = []
    seen: set[str] = set()
    for item in changed:
        path = item.get("path", "").strip()
        if not path or path in seen:
            continue
        result.append(item)
        seen.add(path)
    return result[:200]


def detect_changed_files(root: Path) -> list[dict[str, str]]:
    try:
        completed = subprocess.run(
            ["git", "status", "--short"],
            cwd=root,
            text=True,
            capture_output=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if completed.returncode != 0:
        return []
    changed = []
    for line in completed.stdout.splitlines():
        if len(line) < 4:
            continue
        status = line[:2]
        path = line[3:].strip()
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        changed.append({"path": path, "change_type": classify_git_status(status), "detected_by": "git-status"})
    return changed[:200]


def classify_git_status(status: str) -> str:
    if "D" in status:
        return "deleted"
    if "A" in status or "?" in status:
        return "added"
    if "R" in status:
        return "renamed"
    return "modified"


def ensure_current_run(root: Path) -> dict[str, object]:
    initialize_memory_state(root)
    active_path = root / ".logos" / "memory" / "active-work.json"
    active = read_json(active_path) or {}
    active_plan_id = active.get("active_plan_id")
    active_run_id = active.get("active_run_id")
    if isinstance(active_run_id, str):
        existing = read_json(root / ".logos" / "runs" / active_run_id / "run.json")
        if existing is not None and (
            not isinstance(active_plan_id, str) or existing.get("plan_id") == active_plan_id
        ):
            return existing
    run_id = datetime.now(timezone.utc).strftime("run-%Y%m%dT%H%M%S%fZ")
    run = {
        "schema_version": 1,
        "run_id": run_id,
        "plan_id": active_plan_id,
        "selected_mode": "nous",
        "status": "active",
        "started_at": datetime.now(timezone.utc).isoformat(),
        "ended_at": None,
        "user_request": None,
        "summary": "",
        "execution_summary": "",
        "execution_deviations": [],
        "verification_summary": "",
        "test_summary": "",
        "final_response_summary": "",
        "failure_reason": None,
        "last_command": None,
        "last_error": None,
        "touched_files": [],
        "command_count": 0,
        "guard_decision_count": 0,
        "test_count": 0,
        "failed_test_count": 0,
        "artifact_paths": artifact_paths(active_plan_id),
    }
    write_json(root / ".logos" / "runs" / run_id / "run.json", run)
    active.update(
        {
            "schema_version": 1,
            "status": "active",
            "active_plan_id": active_plan_id,
            "active_run_id": run_id,
            "updated_at": datetime.now(timezone.utc).isoformat(),
        }
    )
    write_json(active_path, active)
    update_run_index(root, run)
    return run


def artifact_paths(plan_id: object) -> dict[str, str]:
    if not isinstance(plan_id, str) or not plan_id:
        return {}
    base = f".logos/plans/{plan_id}"
    return {
        "plan_state": f"{base}/plan-state.json",
        "request": f"{base}/request.json",
        "scan_result": f"{base}/stages/scan/result.json",
        "intake_result": f"{base}/stages/intake/result.json",
        "spec": f"{base}/spec.json",
        "task_plan": f"{base}/task-plan.json",
        "context_handoff": f"{base}/context-handoff.json",
        "review_lite": f"{base}/review-lite.json",
        "execution_result": f"{base}/execution-result.json",
        "verification_result": f"{base}/verification-result.json",
    }


def initialize_memory_state(root: Path) -> None:
    memory = root / ".logos" / "memory"
    memory.mkdir(parents=True, exist_ok=True)
    write_json_if_missing(
        memory / "active-work.json",
        {
            "schema_version": 1,
            "status": "idle",
            "active_plan_id": None,
            "active_run_id": None,
            "updated_at": datetime.now(timezone.utc).isoformat(),
        },
    )
    write_json_if_missing(
        memory / "run-index.json",
        {"schema_version": 1, "runs": [], "updated_at": datetime.now(timezone.utc).isoformat()},
    )
    write_json_if_missing(
        memory / "open-items.json",
        {"schema_version": 1, "items": [], "updated_at": datetime.now(timezone.utc).isoformat()},
    )
    snapshot = memory / "resume-snapshot.md"
    if not snapshot.exists():
        snapshot.write_text(
            "# Logos Resume Snapshot\n\nStatus: idle\n\nNo active Logos work has been recorded yet.\n",
            encoding="utf-8",
        )


def update_run_index(root: Path, run: dict[str, object]) -> None:
    index_path = root / ".logos" / "memory" / "run-index.json"
    index = read_json(index_path) or {"schema_version": 1, "runs": []}
    runs = index.setdefault("runs", [])
    if isinstance(runs, list):
        active_run_id_value = active_run_id(root)
        runs[:] = [item for item in runs if not isinstance(item, dict) or item.get("run_id") != run["run_id"]]
        for item in runs:
            if (
                isinstance(item, dict)
                and item.get("status") == "active"
                and item.get("run_id") != active_run_id_value
            ):
                item["status"] = "stale"
        runs.append(
            {
                "run_id": run["run_id"],
                "plan_id": run.get("plan_id"),
                "status": run.get("status"),
                "started_at": run.get("started_at"),
                "summary": run.get("summary", ""),
                "touched_files": run.get("touched_files", []),
            }
        )
        del runs[:-25]
    index["updated_at"] = datetime.now(timezone.utc).isoformat()
    write_json(index_path, index)


def update_resume_snapshot(root: Path, run: dict[str, object]) -> None:
    touched = run.get("touched_files") if isinstance(run.get("touched_files"), list) else []
    artifact_paths_value = run.get("artifact_paths")
    artifact_paths_map = artifact_paths_value if isinstance(artifact_paths_value, dict) else {}
    plan_id = run.get("plan_id")
    lines = [
        "# Logos Resume Snapshot",
        "",
        "Read this file only when continuing after context loss, compaction, or an unclear work state.",
        "Do not scan raw `.logos/runs` or `.logos/evidence` first.",
        "",
        f"Updated: {datetime.now(timezone.utc).isoformat()}",
        f"Status: {run.get('status') or 'unknown'}",
        f"Current task: {run.get('summary') or 'Active Logos work'}",
        f"Last run id: {run.get('run_id')}",
        f"Active plan id: {plan_id}",
        "",
        "## Current Summaries",
        f"- Execution: {run.get('execution_summary') or 'Not recorded yet.'}",
        f"- Deviations: {format_deviations(run.get('execution_deviations'))}",
        f"- Tests: {run.get('test_summary') or 'Not recorded yet.'}",
        f"- Verification: {run.get('verification_summary') or 'Not recorded yet.'}",
        "",
        "## Touched Files",
    ]
    lines.extend([f"- {item}" for item in touched[:20]] or ["- None"])
    look_next = [
        ".logos/memory/active-work.json",
        ".logos/memory/run-index.json",
        str(artifact_paths_map.get("plan_state") or f".logos/plans/{plan_id}/plan-state.json"),
        str(artifact_paths_map.get("task_plan") or f".logos/plans/{plan_id}/task-plan.json"),
    ]
    execution_result = artifact_paths_map.get("execution_result")
    verification_result = artifact_paths_map.get("verification_result")
    if execution_result:
        look_next.append(str(execution_result))
    if verification_result:
        look_next.append(str(verification_result))
    lines.extend(["", "## Where To Look Next"])
    lines.extend(f"- {item}" for item in look_next[:8])
    (root / ".logos" / "memory" / "resume-snapshot.md").write_text(
        "\n".join(lines).rstrip() + "\n",
        encoding="utf-8",
    )


def read_json(path: Path) -> dict[str, object] | None:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return parsed if isinstance(parsed, dict) else None


def write_json(path: Path, payload: dict[str, object]) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(safe_json_dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    except OSError:
        return


def write_json_if_missing(path: Path, payload: dict[str, object]) -> None:
    if path.exists():
        return
    write_json(path, payload)


def append_jsonl(path: Path, payload: dict[str, object]) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as stream:
            stream.write(safe_json_dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        return


def file_record_exists(path: Path, candidate_path: str) -> bool:
    if not path.exists():
        return False
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            parsed = json.loads(line)
            if isinstance(parsed, dict) and parsed.get("path") == candidate_path:
                return True
    except (OSError, json.JSONDecodeError):
        return False
    return False


def active_run_id(root: Path) -> str | None:
    active = read_json(root / ".logos" / "memory" / "active-work.json") or {}
    value = active.get("active_run_id")
    return value if isinstance(value, str) else None


def format_deviations(value: object) -> str:
    if not isinstance(value, list) or not value:
        return "None"
    return "; ".join(str(item) for item in value[:5])


def find_key(value: object, key: str) -> object:
    if isinstance(value, dict):
        if key in value:
            return value[key]
        for nested in value.values():
            found = find_key(nested, key)
            if found is not None:
                return found
    elif isinstance(value, list):
        for nested in value:
            found = find_key(nested, key)
            if found is not None:
                return found
    return None


def find_all_keys(value: object, key: str):
    if isinstance(value, dict):
        if key in value:
            yield value[key]
        for nested in value.values():
            yield from find_all_keys(nested, key)
    elif isinstance(value, list):
        for nested in value:
            yield from find_all_keys(nested, key)


def collect_text(value: object) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        return "\n".join(collect_text(item) for item in value.values())
    if isinstance(value, list):
        return "\n".join(collect_text(item) for item in value)
    return ""


def record_unhandled_hook_error(exc: Exception) -> None:
    root = Path.cwd()
    path = root / ".logos" / "evidence" / "hook-errors.jsonl"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as stream:
            stream.write(
                safe_json_dumps(
                    {
                        "schema_version": 1,
                        "recorded_at": datetime.now(timezone.utc).isoformat(),
                        "hook": "PostToolUse",
                        "error": str(exc),
                    },
                    ensure_ascii=False,
                    sort_keys=True,
                )
                + "\n"
            )
    except OSError:
        return


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        record_unhandled_hook_error(exc)
        raise SystemExit(0)
